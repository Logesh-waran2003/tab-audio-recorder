{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.3.0",
  "description": "Record any tab plus your own microphone on separate channels, with live meters, a global shortcut, and a transcript that knows who said what. Fully local.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "audioCapture",
    "offscreen",
    "downloads",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "speakers.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Start or stop recording",
      "global": true
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Audio Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
